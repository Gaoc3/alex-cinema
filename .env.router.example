# Copy to .env.router on the Earthlink-connected router/mini-PC.
VPS_HOST=CHANGE_ME_VPS_IP_OR_HOSTNAME
VPS_TUNNEL_SSH_PORT=2222
VPS_TUNNEL_USER=tunnel
REMOTE_TUNNEL_BIND=0.0.0.0
REMOTE_TUNNEL_PORT=8443
