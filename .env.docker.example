# Copy to .env.docker and replace every CHANGE_ME value.
# NEXT_PUBLIC_* values are embedded in the browser bundle and are not secrets.

COMPOSE_PROJECT_NAME=alex-cinema
IMAGE_TAG=local
NODE_VERSION=24.12.0

# Public edge and automatic TLS
APP_ORIGIN=https://cinax.live
APP_DOMAINS=cinax.live, www.cinax.live
ACME_EMAIL=CHANGE_ME@example.com
HTTP_BIND=0.0.0.0
HTTPS_BIND=0.0.0.0

# PostgreSQL. URL-encode password special characters inside DATABASE_URL.
POSTGRES_DB=alex_cinema
POSTGRES_USER=alex
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://alex:CHANGE_ME_URL_ENCODED_DATABASE_PASSWORD@postgres:5432/alex_cinema?schema=public
BACKUP_RETENTION_DAYS=14

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=CHANGE_ME
CLERK_SECRET_KEY=CHANGE_ME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/home
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/home

# Telegram Mini App, browser OIDC, and bot
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CLIENT_ID=CHANGE_ME
TELEGRAM_CLIENT_SECRET=CHANGE_ME
TELEGRAM_SESSION_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
TELEGRAM_WEB_APP_URL=https://cinax.live/tg-app
TELEGRAM_HOME_URL=https://cinax.live/home
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/CHANGE_ME_BOT

# Application and room security
PROXY_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
PROXY_SECRET_LEGACY=
SOCKET_AUTH_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
NEXT_PUBLIC_CRYPTO_SECRET=CHANGE_ME_PUBLIC_COMPATIBILITY_VALUE
NEXT_PUBLIC_SOCKET_URL=

# Internal network. Change all three values together if this subnet conflicts.
DOCKER_SUBNET=172.30.250.0/24
TUNNEL_GATEWAY_IP=172.30.250.10
CORE_DNS_IP=172.30.250.53

# Reverse SSH endpoint used by the Earthlink router/bridge.
TUNNEL_SSH_BIND=0.0.0.0
TUNNEL_SSH_PORT=2222
TUNNEL_AUTHORIZED_KEYS_FILE=./docker/tunnel-sshd/secrets/authorized_keys

# Safe monitor: reports failures and never runs root recovery commands.
TUNNEL_HEALTH_HOST=cinemana.shabakaty.com
TUNNEL_HEALTH_PATH=/api/android/banner/level/1
TUNNEL_CHECK_INTERVAL_MS=15000
TUNNEL_CHECK_TIMEOUT_MS=6000
TUNNEL_FAILURE_THRESHOLD=2

