# AleX Cinema local/PM2 environment template. Never commit real credentials.
NODE_ENV=production

# Server-only authenticated proxy token secret (at least 32 random characters)
PROXY_SECRET=replace_with_a_long_random_server_only_secret
PROXY_SECRET_LEGACY=
# Public by design; do not reuse this value as a server-side secret.
NEXT_PUBLIC_CRYPTO_SECRET=replace_with_a_public_compatibility_key

# PostgreSQL and public application origin
DATABASE_URL=postgresql://user:password@localhost:5432/alex_cinema?schema=public
APP_ORIGIN=https://cinax.live

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_me
CLERK_SECRET_KEY=sk_live_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/home
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/home

# Telegram Mini App, browser OIDC, and bot
TELEGRAM_BOT_TOKEN=replace_with_bot_token
TELEGRAM_CLIENT_ID=replace_with_oidc_client_id
TELEGRAM_CLIENT_SECRET=replace_with_oidc_client_secret
TELEGRAM_SESSION_SECRET=replace_with_at_least_32_random_characters
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/replace_me_bot?start=webapp
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
TELEGRAM_WEB_APP_URL=https://cinax.live/tg-app
TELEGRAM_HOME_URL=https://cinax.live/home

# Socket.io rooms
SOCKET_AUTH_SECRET=replace_with_a_separate_long_random_server_secret
SOCKET_HOST=0.0.0.0
SOCKET_PORT=4000
NEXT_PUBLIC_SOCKET_URL=

# Safe Docker tunnel monitor. The legacy PM2 watchdog has separate host assumptions.
TUNNEL_HEALTH_HOST=cinemana.shabakaty.com
TUNNEL_HEALTH_PATH=/api/android/banner/level/1
TUNNEL_CHECK_INTERVAL_MS=15000
TUNNEL_CHECK_TIMEOUT_MS=6000
TUNNEL_FAILURE_THRESHOLD=2

