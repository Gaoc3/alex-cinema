# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.docker.example
!.env.router.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

testsprite_tests\tmp\config.json

/generated/prisma

# local agent/editor state
/.agents/
/.vscode/
/scratch/

# one-off diagnostics and deployment artifacts
__pycache__/
*.py[cod]
/*.py
!/telegram_bot.py
/*.log
/*.txt
!/requirements-bot.txt
/*.html
/*.conf
/*.bak
/*.new
/*.test
/*.db
/*.tar.gz
/test*.js
/check*.js
/decrypt*.js
/poll*.js

# clerk configuration (can include secrets)
/.clerk/

# Docker runtime data and local disaster-recovery artifacts
/backups/
/docker/router/secrets/*
!/docker/router/secrets/.gitkeep
/docker/tunnel-sshd/secrets/*
!/docker/tunnel-sshd/secrets/.gitkeep

next_dist.zip
*.zip
*.pdf
almanjam_invoice_modified.*
crop_*.png
original_rendered.png
pdf_text_dict.json
AAAA*.ttf
Changa-Variable.ttf
